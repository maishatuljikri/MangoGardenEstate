<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.EstateOwner.ProductionRecordController">

    <children>

        <Label layoutX="210.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Mango Production Records" />

        <Label layoutX="50.0" layoutY="80.0" text="Production ID :" />

        <TextField fx:id="txtProductionId" layoutX="180.0" layoutY="75.0" prefWidth="220.0" />

        <Label layoutX="50.0" layoutY="125.0" text="Harvest Date :" />

        <TextField fx:id="txtHarvestDate" layoutX="180.0" layoutY="120.0" prefWidth="220.0" />

        <Label layoutX="50.0" layoutY="170.0" text="Garden Section :" />

        <TextField fx:id="txtSection" layoutX="180.0" layoutY="165.0" prefWidth="220.0" />

        <Label layoutX="50.0" layoutY="215.0" text="Mango Variety :" />

        <TextField fx:id="txtVariety" layoutX="180.0" layoutY="210.0" prefWidth="220.0" />

        <Label layoutX="50.0" layoutY="260.0" text="Production (Kg) :" />

        <TextField fx:id="txtQuantity" layoutX="180.0" layoutY="255.0" prefWidth="220.0" />

        <Label layoutX="50.0" layoutY="305.0" text="Production Summary :" />

        <TextArea fx:id="txtSummary" layoutX="180.0" layoutY="300.0" prefHeight="100.0" prefWidth="350.0" />

        <Button layoutX="460.0" layoutY="75.0" onAction="#searchRecordOA" prefWidth="120.0" text="Search" />

        <Button layoutX="120.0" layoutY="430.0" onAction="#calculateProductionOA" prefWidth="140.0" text="Calculate" />

        <Button layoutX="280.0" layoutY="430.0" onAction="#viewRecordOA" prefWidth="120.0" text="View" />

        <Button layoutX="420.0" layoutY="430.0" onAction="#clearFormOA" prefWidth="120.0" text="Clear" />

    </children>

</AnchorPane>
