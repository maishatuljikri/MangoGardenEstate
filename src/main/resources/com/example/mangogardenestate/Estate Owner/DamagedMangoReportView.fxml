<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="560.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.EstateOwner.DamagedMangoReportController">

    <children>

        <!-- Title -->
        <Label layoutX="170.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Damaged Mango Report" />

        <!-- Report ID -->
        <Label layoutX="50.0" layoutY="80.0" text="Report ID :" />

        <TextField fx:id="txtReportId" layoutX="180.0" layoutY="75.0" prefWidth="220.0" />

        <!-- Report Date -->
        <Label layoutX="50.0" layoutY="125.0" text="Report Date :" />

        <TextField fx:id="txtReportDate" layoutX="180.0" layoutY="120.0" prefWidth="220.0" />

        <!-- Mango Variety -->
        <Label layoutX="50.0" layoutY="170.0" text="Mango Variety :" />

        <TextField fx:id="txtVariety" layoutX="180.0" layoutY="165.0" prefWidth="220.0" />

        <!-- Damaged Quantity -->
        <Label layoutX="50.0" layoutY="215.0" text="Damaged Quantity :" />

        <TextField fx:id="txtQuantity" layoutX="180.0" layoutY="210.0" prefWidth="220.0" />

        <!-- Damage Reason -->
        <Label layoutX="50.0" layoutY="260.0" text="Damage Reason :" />

        <TextField fx:id="txtReason" layoutX="180.0" layoutY="255.0" prefWidth="220.0" />

        <!-- Report Summary -->
        <Label layoutX="50.0" layoutY="305.0" text="Report Summary :" />

        <TextArea fx:id="txtSummary" layoutX="180.0" layoutY="300.0" prefHeight="120.0" prefWidth="360.0" />

        <!-- Buttons -->
        <Button layoutX="430.0" layoutY="75.0" onAction="#searchReportOA" prefWidth="120.0" text="Search" />

        <Button layoutX="80.0" layoutY="455.0" onAction="#calculateDamageOA" prefWidth="130.0" text="Calculate" />

        <Button layoutX="240.0" layoutY="455.0" onAction="#viewReportOA" prefWidth="130.0" text="View" />

        <Button layoutX="400.0" layoutY="455.0" onAction="#clearFormOA" prefWidth="130.0" text="Clear" />

        <Button layoutX="560.0" layoutY="455.0" onAction="#goBackOA" prefWidth="100.0" text="Back" />

    </children>

</AnchorPane>
