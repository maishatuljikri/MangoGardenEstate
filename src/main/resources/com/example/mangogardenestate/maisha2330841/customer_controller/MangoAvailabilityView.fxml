<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.maisha2330841.customer_controller.MangoAvailabilityViewController">

    <children>

        <!-- Title -->
        <Label layoutX="250.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Customer - Check Mango Availability" />

        <!-- Search Section -->
        <Label layoutX="40.0" layoutY="75.0" text="Mango Type:" />

        <TextField fx:id="MangoTypeTF" layoutX="130.0" layoutY="70.0" prefWidth="220.0" promptText="Enter Mango Variety" />

        <Button layoutX="380.0" layoutY="70.0" onAction="#searchButton" text="Search" />

        <!-- Mango Stock Table -->
        <TableView fx:id="stockTable" layoutX="40.0" layoutY="120.0" prefHeight="400.0" prefWidth="820.0">

            <columns>

                <TableColumn fx:id="mangoIdColumn" prefWidth="90" text="Mango ID" />

                <TableColumn fx:id="varietyColumn" prefWidth="170" text="Mango Variety" />

                <TableColumn fx:id="priceColumn" prefWidth="110" text="Price/Kg" />

                <TableColumn fx:id="stockColumn" prefWidth="140" text="Available Stock" />

                <TableColumn fx:id="harvestDateColumn" prefWidth="140" text="Harvest Date" />

                <TableColumn fx:id="statusColumn" prefWidth="150" text="Status" />

            </columns>

        </TableView>

        <!-- Back Button -->
        <Button fx:id="backButton" layoutX="390.0" layoutY="550.0" text="Back to Dashboard" />

    </children>

</AnchorPane>
