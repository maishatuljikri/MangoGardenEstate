<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.maisha2330841.farmer_controller.TreeDiseaseViewController">

    <children>

        <!-- Title -->
        <Label alignment="CENTER" layoutX="155.0" layoutY="21.0" prefHeight="32.0" prefWidth="450.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="           Farmer - Tree Disease Report" />

          <!-- Tree ID -->
          <Label layoutX="50.0" layoutY="74.0" text="Tree ID:" />

          <TextField fx:id="treeIdField" layoutX="235.60000610351562" layoutY="70.0" promptText="Enter Tree ID" />

          <!-- Garden Section -->
          <Label layoutX="50.0" layoutY="118.0" text="Garden Section:" />

          <ComboBox fx:id="sectionComboBox" layoutX="235.60000610351562" layoutY="114.0" prefWidth="220" />

          <!-- Report Date -->
          <Label layoutX="50.0" layoutY="162.0" text="Report Date:" />

          <DatePicker fx:id="reportDatePicker" layoutX="235.60000610351562" layoutY="158.0" />

          <!-- Disease Type -->
          <Label layoutX="50.0" layoutY="206.0" text="Disease Type:" />

          <ComboBox fx:id="diseaseTypeComboBox" layoutX="235.60000610351562" layoutY="202.0" prefWidth="220" />

          <!-- Severity -->
          <Label layoutX="50.0" layoutY="250.0" text="Severity:" />

          <ComboBox fx:id="severityComboBox" layoutX="235.60000610351562" layoutY="246.0" prefWidth="220" />

          <!-- Disease Description -->
          <Label layoutX="50.0" layoutY="341.20001220703125" text="Disease Description:" />

          <TextArea fx:id="descriptionArea" layoutX="235.60000610351562" layoutY="290.0" prefHeight="120" prefWidth="320" promptText="Describe symptoms of the disease..." />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="500.0" mnemonicParsing="false" onAction="#submitButtonOA" text="Submit Report" />

        <Button layoutX="390.0" layoutY="500.0" mnemonicParsing="false" onAction="#clearButtonButtonOA" text="Clear" />

        <!-- Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="550.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />
      <Button layoutX="465.0" layoutY="506.0" mnemonicParsing="false" onAction="#backButtonOA" text="back" />

    </children>

</AnchorPane>
