        <Button layoutX="300.0" layoutY="540.0" onAction="#downloadButtonOA" text="Download Invoice" />

        <Button layoutX="520.0" layoutY="540.0" onAction="#backButtonOA" text="Back to Dashboard" />

        <!-- Status Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="590.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />
      <Label layoutX="48.0" layoutY="114.0" prefHeight="18.0" prefWidth="65.0" text="Order ID:" />
      <Label layoutX="48.0" layoutY="273.0" prefHeight="18.0" prefWidth="98.0" text="Payment Date:" />
      <Label layoutX="41.0" layoutY="152.0" prefHeight="18.0" prefWidth="89.0" text="Invoice ID:" />
      <Label layoutX="45.0" layoutY="194.0" prefHeight="18.0" prefWidth="111.0" text="Customer Name:" />
      <Label layoutX="45.0" layoutY="232.0" prefHeight="18.0" prefWidth="111.0" text="Payment Amount:" />
      <TextField layoutX="238.0" layoutY="110.0" prefHeight="26.0" prefWidth="367.0" />
      <TextField layoutX="233.0" layoutY="148.0" prefHeight="26.0" prefWidth="378.0" />
      <TextField layoutX="233.0" layoutY="190.0" prefHeight="26.0" prefWidth="378.0" />
      <TextField layoutX="233.0" layoutY="228.0" prefHeight="26.0" prefWidth="378.0" />
      <TextField layoutX="235.0" layoutY="269.0" prefHeight="26.0" prefWidth="378.0" />
      <ComboBox layoutX="38.0" layoutY="313.0" prefWidth="150.0" promptText="Payment Method" />

    </children>

</AnchorPane>
