<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="620.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.CheckMangoAvailabilityController">

    <children>

        <!-- Title -->
        <Label layoutX="250.0"
               layoutY="20.0"
               text="Customer - Check Mango Availability"
               style="-fx-font-size:22px; -fx-font-weight:bold;" />

        <!-- Search Section -->
        <Label layoutX="40.0"
               layoutY="75.0"
               text="Mango Type:"/>

        <TextField fx:id="searchField"
                   layoutX="130.0"
                   layoutY="70.0"
                   prefWidth="220.0"
                   promptText="Enter Mango Variety"/>

        <Button fx:id="searchButton"
                layoutX="380.0"
                layoutY="70.0"
                text="Search"/>

        <!-- Mango Stock Table -->
        <TableView fx:id="stockTable"
                   layoutX="40.0"
                   layoutY="120.0"
                   prefHeight="400.0"
                   prefWidth="820.0">

            <columns>

                <TableColumn fx:id="mangoIdColumn"
                             text="Mango ID"
                             prefWidth="90"/>

                <TableColumn fx:id="varietyColumn"
                             text="Mango Variety"
                             prefWidth="170"/>

                <TableColumn fx:id="priceColumn"
                             text="Price/Kg"
                             prefWidth="110"/>

                <TableColumn fx:id="stockColumn"
                             text="Available Stock"
                             prefWidth="140"/>

                <TableColumn fx:id="harvestDateColumn"
                             text="Harvest Date"
                             prefWidth="140"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="150"/>

            </columns>

        </TableView>

        <!-- Back Button -->
        <Button fx:id="backButton"
                layoutX="390.0"
                layoutY="550.0"
                text="Back to Dashboard"/>

    </children>

</AnchorPane>
