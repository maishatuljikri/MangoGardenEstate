<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Customer.CancelOrdersViewController">

    <children>

        <!-- Title -->
        <Label layoutX="250.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Customer - Cancel Order" />

          <!-- Order ID -->
          <Label layoutX="50.0" layoutY="74.0" text="Order ID:" />

          <TextField fx:id="orderIdField" layoutX="245.1999969482422" layoutY="70.0" promptText="Enter Order ID" />

          <!-- Order Status -->
          <Label layoutX="50.0" layoutY="114.0" text="Order Status:" />

          <Label fx:id="statusLabel" layoutX="245.1999969482422" layoutY="114.0" text="Pending" />

          <!-- Cancellation Date -->
          <Label layoutX="50.0" layoutY="154.0" text="Cancellation Date:" />

          <DatePicker fx:id="cancelDatePicker" layoutX="245.1999969482422" layoutY="150.0" />

          <!-- Cancellation Reason -->
          <Label layoutX="50.0" layoutY="198.0" text="Cancellation Reason:" />

          <ComboBox fx:id="reasonComboBox" layoutX="245.1999969482422" layoutY="194.0" prefWidth="250" promptText="Select Reason" />

          <!-- Additional Comments -->
          <Label layoutX="50.0" layoutY="289.20001220703125" text="Additional Comments:" />

          <TextArea fx:id="commentsArea" layoutX="245.1999969482422" layoutY="238.0" prefHeight="120" prefWidth="320" promptText="Enter additional comments (optional)" />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="530.0" mnemonicParsing="false" onAction="#submitButtonOA" text="Submit Cancellation" />

        <Button layoutX="430.0" layoutY="530.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear" />

        <!-- Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="575.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>
