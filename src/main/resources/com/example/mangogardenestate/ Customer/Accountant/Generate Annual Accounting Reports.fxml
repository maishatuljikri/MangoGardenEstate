<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Accountant.GenerateAnnualReportViewController">

    <children>

        <!-- Title -->
        <Label layoutX="220.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Accountant - Annual Accounting Report" />

        <!-- Select Fiscal Year -->
        <Label layoutX="50.0" layoutY="74.0" text="Select Fiscal Year:" />
        <TextField fx:id="fiscalYearField" layoutX="170.0" layoutY="70.0" prefWidth="150.0" promptText="e.g. 2026" />

        <!-- Report Type -->
        <Label layoutX="350.0" layoutY="74.0" text="Report Type:" />
        <ComboBox fx:id="reportTypeComboBox" layoutX="440.0" layoutY="70.0" prefWidth="180.0" promptText="Select Report Type" />

        <!-- Buttons -->
        <Button layoutX="180.0" layoutY="120.0" mnemonicParsing="false" onAction="#generateAnnualReportButtonOA" text="Generate Report" />
        <Button layoutX="330.0" layoutY="120.0" mnemonicParsing="false" onAction="#downloadReportButtonOA" text="Download Report" />
        <Button layoutX="480.0" layoutY="120.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear" />

        <!-- Annual Summary Table -->
        <TableView fx:id="annualReportTable" layoutX="50.0" layoutY="170.0" prefHeight="360.0" prefWidth="680.0">
            <columns>
                <TableColumn fx:id="quarterColumn" prefWidth="120.0" text="Quarter / Period" />
                <TableColumn fx:id="totalRevenueColumn" prefWidth="180.0" text="Total Revenue ($)" />
                <TableColumn fx:id="totalExpensesColumn" prefWidth="180.0" text="Total Expenses ($)" />
                <TableColumn fx:id="netProfitColumn" prefWidth="198.0" text="Net Profit / Loss ($)" />
            </columns>
        </TableView>

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="50.0" layoutY="550.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>