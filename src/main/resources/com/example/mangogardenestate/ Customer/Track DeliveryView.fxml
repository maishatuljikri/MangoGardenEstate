<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Customer.TrackDeliveryViewController">

    <children>

        <!-- Title -->
        <Label layoutX="300.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Customer - Track Delivery Status" />

        <!-- Search Section -->
        <Label layoutX="40.0" layoutY="75.0" text="Order ID:" />

        <TextField fx:id="orderIdField" layoutX="120.0" layoutY="70.0" prefWidth="220.0" promptText="Enter Order ID" />

        <Button layoutX="370.0" layoutY="70.0" onAction="#searchButtonOA" text="Search" />

        <!-- Delivery Status Table -->
        <TableView fx:id="deliveryTable" layoutX="40.0" layoutY="120.0" prefHeight="400.0" prefWidth="870.0">

            <columns>

                <TableColumn fx:id="orderIdColumn" prefWidth="100" text="Order ID" />

                <TableColumn fx:id="deliveryIdColumn" prefWidth="100" text="Delivery ID" />

                <TableColumn fx:id="addressColumn" prefWidth="220" text="Delivery Address" />

                <TableColumn fx:id="deliveryDateColumn" prefWidth="130" text="Delivery Date" />

                <TableColumn fx:id="statusColumn" prefWidth="160" text="Delivery Status" />

                <TableColumn fx:id="deliveryPersonColumn" prefWidth="160" text="Delivery Person" />

            </columns>

        </TableView>

        <!-- Buttons -->
        <Button layoutX="280.0" layoutY="550.0" onAction="#refreshButtonOA" text="Refresh Status" />

        <Button layoutX="470.0" layoutY="550.0" onAction="#backButtonOA" text="Back to Dashboard" />

    </children>

</AnchorPane>
