<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="620.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.TrackDeliveryController">

    <children>

        <!-- Title -->
        <Label layoutX="300.0"
               layoutY="20.0"
               text="Customer - Track Delivery Status"
               style="-fx-font-size:22px; -fx-font-weight:bold;" />

        <!-- Search Section -->
        <Label layoutX="40.0"
               layoutY="75.0"
               text="Order ID:"/>

        <TextField fx:id="orderIdField"
                   layoutX="120.0"
                   layoutY="70.0"
                   prefWidth="220.0"
                   promptText="Enter Order ID"/>

        <Button fx:id="searchButton"
                layoutX="370.0"
                layoutY="70.0"
                text="Search"/>

        <!-- Delivery Status Table -->
        <TableView fx:id="deliveryTable"
                   layoutX="40.0"
                   layoutY="120.0"
                   prefHeight="400.0"
                   prefWidth="870.0">

            <columns>

                <TableColumn fx:id="orderIdColumn"
                             text="Order ID"
                             prefWidth="100"/>

                <TableColumn fx:id="deliveryIdColumn"
                             text="Delivery ID"
                             prefWidth="100"/>

                <TableColumn fx:id="addressColumn"
                             text="Delivery Address"
                             prefWidth="220"/>

                <TableColumn fx:id="deliveryDateColumn"
                             text="Delivery Date"
                             prefWidth="130"/>

                <TableColumn fx:id="statusColumn"
                             text="Delivery Status"
                             prefWidth="160"/>

                <TableColumn fx:id="deliveryPersonColumn"
                             text="Delivery Person"
                             prefWidth="160"/>

            </columns>

        </TableView>

        <!-- Buttons -->
        <Button fx:id="refreshButton"
                layoutX="280.0"
                layoutY="550.0"
                text="Refresh Status"/>

        <Button fx:id="backButton"
                layoutX="470.0"
                layoutY="550.0"
                text="Back to Dashboard"/>

    </children>

</AnchorPane>
