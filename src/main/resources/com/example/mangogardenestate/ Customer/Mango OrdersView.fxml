<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650.0" prefWidth="780.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.mangogardenestate.Customer.MangoOrdersViewController">

    <children>

        <!-- Title -->
        <Label layoutX="220.0"
               layoutY="20.0"
               text="Customer - Place Mango Order"
               style="-fx-font-size:22px; -fx-font-weight:bold;" />

        <!-- Order Form -->
        <GridPane layoutX="50.0"
                  layoutY="70.0"
                  hgap="15"
                  vgap="18">

            <columnConstraints>
                <ColumnConstraints prefWidth="180"/>
                <ColumnConstraints prefWidth="350"/>
            </columnConstraints>

            <children>

                <!-- Customer ID -->
                <Label text="Customer ID:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="customerIdField"
                           promptText="Enter Customer ID"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <!-- Mango Variety -->
                <Label text="Mango Variety:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="mangoComboBox"
                          prefWidth="220"
                          promptText="Select Mango Variety"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <!-- Price -->
                <Label text="Price per Kg:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <Label fx:id="priceLabel"
                       text="৳0.00"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

                <!-- Stock -->
                <Label text="Available Stock:"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <Label fx:id="stockLabel"
                       text="0 Kg"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="1"/>

                <!-- Quantity -->
                <Label text="Order Quantity (Kg):"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="quantityField"
                           promptText="Enter Quantity"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="1"/>

                <!-- Delivery Date -->
                <Label text="Delivery Date:"
                       GridPane.rowIndex="5"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="deliveryDatePicker"
                            GridPane.rowIndex="5"
                            GridPane.columnIndex="1"/>

                <!-- Delivery Address -->
                <Label text="Delivery Address:"
                       GridPane.rowIndex="6"
                       GridPane.columnIndex="0"/>

                <TextArea fx:id="addressArea"
                          prefHeight="100"
                          prefWidth="320"
                          promptText="Enter Delivery Address"
                          GridPane.rowIndex="6"
                          GridPane.columnIndex="1"/>

            </children>

        </GridPane>

        <!-- Buttons -->
        <Button fx:id="placeOrderButton"
                layoutX="220.0"
                layoutY="560.0"
                text="Place Order"/>

        <Button fx:id="clearButton"
                layoutX="390.0"
                layoutY="560.0"
                text="Clear"/>

        <!-- Confirmation Message -->
        <Label fx:id="messageLabel"
               layoutX="220.0"
               layoutY="605.0"
               text=""
               style="-fx-text-fill:green; -fx-font-size:14px;"/>

    </children>

</AnchorPane>