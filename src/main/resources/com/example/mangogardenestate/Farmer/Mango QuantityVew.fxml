<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Farmer.MangoQuantityViewController">

    <children>

        <!-- Title -->
        <Label layoutX="170.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Farmer - Record Harvested Mango Quantity" />

          <!-- Harvest Date -->
          <Label layoutX="50.0" layoutY="74.0" text="Harvest Date:" />

          <DatePicker fx:id="harvestDatePicker" layoutX="245.1999969482422" layoutY="70.0" />

          <!-- Garden Section -->
          <Label layoutX="50.0" layoutY="118.0" text="Garden Section:" />

          <ComboBox fx:id="sectionComboBox" layoutX="245.1999969482422" layoutY="114.0" prefWidth="220" promptText="Select Section" />

          <!-- Mango Variety -->
          <Label layoutX="50.0" layoutY="162.0" text="Mango Variety:" />

          <TextField fx:id="varietyField" layoutX="245.1999969482422" layoutY="158.0" promptText="Enter Mango Variety" />

          <!-- Harvest Quantity -->
          <Label layoutX="50.0" layoutY="206.0" text="Harvest Quantity (kg):" />

          <TextField fx:id="quantityField" layoutX="245.1999969482422" layoutY="202.0" promptText="Enter Quantity" />

          <!-- Quality Grade -->
          <Label layoutX="50.0" layoutY="250.0" text="Quality Grade:" />

          <ComboBox fx:id="gradeComboBox" layoutX="245.1999969482422" layoutY="246.0" prefWidth="220" promptText="Select Grade" />

          <!-- Remarks -->
          <Label layoutX="50.0" layoutY="341.20001220703125" text="Remarks:" />

          <TextArea fx:id="remarksArea" layoutX="245.1999969482422" layoutY="290.0" prefHeight="120" prefWidth="320" promptText="Additional remarks..." />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="520.0" mnemonicParsing="false" onAction="#saveButtonOA" text="Save Harvest Record" />

        <Button layoutX="420.0" layoutY="520.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear" />

        <!-- Success Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="570.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>
