<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Farmer.IrrigationCompletionStatusViewController">

    <children>

        <!-- Title -->
        <Label layoutX="180.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="com.example.mangogardenestate.Farmer - Update Irrigation Status" />

          <!-- Irrigation ID -->
          <Label layoutX="50.0" layoutY="74.0" text="Irrigation ID:" />

          <TextField fx:id="irrigationIdField" layoutX="245.1999969482422" layoutY="70.0" promptText="Enter Irrigation ID" />

          <!-- Garden Section -->
          <Label layoutX="50.0" layoutY="118.0" text="Garden Section:" />

          <ComboBox fx:id="sectionComboBox" layoutX="245.1999969482422" layoutY="114.0" prefWidth="220" promptText="Select Section" />

          <!-- Irrigation Date -->
          <Label layoutX="50.0" layoutY="162.0" text="Irrigation Date:" />

          <DatePicker fx:id="irrigationDatePicker" layoutX="245.1999969482422" layoutY="158.0" />

          <!-- Duration -->
          <Label layoutX="50.0" layoutY="206.0" text="Duration (Hours):" />

          <TextField fx:id="durationField" layoutX="245.1999969482422" layoutY="202.0" promptText="Enter Duration" />

          <!-- Water Amount -->
          <Label layoutX="50.0" layoutY="250.0" text="Water Used (Liters):" />

          <TextField fx:id="waterAmountField" layoutX="245.1999969482422" layoutY="246.0" promptText="Enter Water Amount" />

          <!-- Completion Status -->
          <Label layoutX="50.0" layoutY="294.0" text="Completion Status:" />

          <ComboBox fx:id="statusComboBox" layoutX="245.1999969482422" layoutY="290.0" prefWidth="220" promptText="Select Status" />

          <!-- Remarks -->
          <Label layoutX="50.0" layoutY="375.6000061035156" text="Remarks:" />

          <TextArea fx:id="remarksArea" layoutX="245.1999969482422" layoutY="334.0" prefHeight="100" prefWidth="320" promptText="Enter additional remarks..." />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="540.0" mnemonicParsing="false" onAction="#saveButtonOA" text="Save Status" />

        <Button layoutX="390.0" layoutY="540.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear" />

        <!-- Update Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="585.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>
