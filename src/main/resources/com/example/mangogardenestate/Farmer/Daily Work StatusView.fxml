<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="550.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Farmer.DailyWorkStatusViewController">

    <children>

        <Label layoutX="180.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="com.example.mangogardenestate.Farmer - Daily Work Update" />

          <!-- Work Title -->
          <Label layoutX="60.0" layoutY="84.0" text="Work Title:" />

          <TextField fx:id="workTitleField" layoutX="225.60000610351562" layoutY="80.0" promptText="Enter work title" />

          <!-- Date -->
          <Label layoutX="60.0" layoutY="128.0" text="Work Date:" />

          <DatePicker fx:id="workDatePicker" layoutX="225.60000610351562" layoutY="124.0" />

          <!-- Assigned Task -->
          <Label layoutX="60.0" layoutY="172.0" text="Assigned Task:" />

          <TextField fx:id="assignedTaskField" editable="false" layoutX="225.60000610351562" layoutY="168.0" promptText="Loaded automatically" />

          <!-- Work Description -->
          <Label layoutX="60.0" layoutY="263.20001220703125" text="Work Details:" />

          <TextArea fx:id="workDetailsArea" layoutX="225.60000610351562" layoutY="212.0" prefHeight="120" prefWidth="300" promptText="Enter today's work details" />

          <!-- Status -->
          <Label layoutX="60.0" layoutY="354.3999938964844" text="Work Status:" />

          <ComboBox fx:id="statusComboBox" layoutX="225.60000610351562" layoutY="350.3999938964844" prefWidth="180" />

        <!-- Buttons -->
        <Button layoutX="220" layoutY="420" mnemonicParsing="false" onAction="#saveButtonOA" text="Save Work Status" />

        <Button layoutX="390" layoutY="420" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear" />

        <!-- Success Message -->
        <Label fx:id="messageLabel" layoutX="220" layoutY="470" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>
