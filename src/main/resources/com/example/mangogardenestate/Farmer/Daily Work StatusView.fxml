<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="550.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.mangogardenestate.Farmer.DailyWorkStatusViewController">

    <children>

        <Label layoutX="150.0"
               layoutY="20.0"
               style="-fx-font-size:22px; -fx-font-weight:bold;"
               text="Farmer - Daily Work Update"/>

        <Label layoutX="60" layoutY="80" text="Work Title:"/>
        <TextField fx:id="workTitleField"
                   layoutX="220"
                   layoutY="76"
                   promptText="Enter work title"/>

        <Label layoutX="60" layoutY="125" text="Work Date:"/>
        <DatePicker fx:id="workDatePicker"
                    layoutX="220"
                    layoutY="120"/>

        <Label layoutX="60" layoutY="170" text="Assigned Task:"/>
        <TextField fx:id="assignedTaskField"
                   layoutX="220"
                   layoutY="165"
                   editable="false"
                   promptText="Loaded automatically"/>

        <Label layoutX="60" layoutY="215" text="Work Details:"/>
        <TextArea fx:id="workDetailsArea"
                  layoutX="220"
                  layoutY="210"
                  prefHeight="120"
                  prefWidth="300"
                  promptText="Enter today's work details"/>

        <Label layoutX="60" layoutY="350" text="Work Status:"/>
        <ComboBox fx:id="statusComboBox"
                  layoutX="220"
                  layoutY="345"
                  prefWidth="180"/>

        <Button layoutX="220"
                layoutY="420"
                text="Save Work Status"
                onAction="#saveButtonOA"/>

        <Button layoutX="390"
                layoutY="420"
                text="Clear"
                onAction="#clearButtonOA"/>

        <Label fx:id="messageLabel"
               layoutX="220"
               layoutY="470"
               style="-fx-text-fill:green; -fx-font-size:14px;"/>

    </children>

</AnchorPane>