<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Farmer.WorkScheduleViewController">

    <children>

        <!-- Title -->
        <Label layoutX="260.0"
               layoutY="20.0"
               text="Farmer - Assigned Work Schedule"
               style="-fx-font-size:22px; -fx-font-weight:bold;" />

        <!-- Work Schedule Table -->
        <TableView fx:id="scheduleTable"
                   layoutX="30.0"
                   layoutY="70.0"
                   prefHeight="420.0"
                   prefWidth="840.0">

            <columns>

                <TableColumn fx:id="taskIdColumn"
                             text="Task ID"
                             prefWidth="80"/>

                <TableColumn fx:id="taskNameColumn"
                             text="Task Name"
                             prefWidth="150"/>

                <TableColumn fx:id="workDateColumn"
                             text="Work Date"
                             prefWidth="120"/>

                <TableColumn fx:id="startTimeColumn"
                             text="Start Time"
                             prefWidth="100"/>

                <TableColumn fx:id="endTimeColumn"
                             text="End Time"
                             prefWidth="100"/>

                <TableColumn fx:id="sectionColumn"
                             text="Garden Section"
                             prefWidth="140"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="120"/>

            </columns>

        </TableView>

        <!-- Buttons -->
        <Button fx:id="printButton"
                layoutX="250.0"
                layoutY="520.0"
                mnemonicParsing="false"
                text="Print Work Schedule"/>

        <Button fx:id="backButton"
                layoutX="470.0"
                layoutY="520.0"
                mnemonicParsing="false"
                text="Back to Dashboard"/>

    </children>

</AnchorPane>