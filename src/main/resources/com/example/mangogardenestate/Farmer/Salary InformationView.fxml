<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Farmer.SalaryInformationViewController">

    <children>

        <!-- Title -->
        <Label layoutX="310.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Farmer - Salary Information" />

          <Label layoutX="40.0" layoutY="74.0" text="Farmer ID:" />

          <TextField fx:id="farmerIdField" editable="false" layoutX="205.60000610351562" layoutY="70.0" />

          <Label layoutX="40.0" layoutY="114.80000305175781" text="Farmer Name:" />

          <TextField fx:id="farmerNameField" editable="false" layoutX="205.60000610351562" layoutY="110.80000305175781" />

        <!-- Salary Table -->
        <TableView fx:id="salaryTable" layoutX="40.0" layoutY="160.0" prefHeight="360.0" prefWidth="870.0">

            <columns>

                <TableColumn fx:id="salaryIdColumn" prefWidth="90" text="Salary ID" />

                <TableColumn fx:id="monthColumn" prefWidth="100" text="Month" />

                <TableColumn fx:id="basicSalaryColumn" prefWidth="130" text="Basic Salary" />

                <TableColumn fx:id="overtimeColumn" prefWidth="110" text="Overtime" />

                <TableColumn fx:id="bonusColumn" prefWidth="100" text="Bonus" />

                <TableColumn fx:id="deductionColumn" prefWidth="110" text="Deduction" />

                <TableColumn fx:id="netSalaryColumn" prefWidth="130" text="Net Salary" />

            </columns>

        </TableView>

        <!-- Buttons -->
        <Button layoutX="180.0" layoutY="560.0" onAction="#generateReportButtonOA" text="Generate Salary Report" />

        <Button layoutX="410.0" layoutY="560.0" onAction="#downloadReportButtonOA" text="Download Report" />

        <Button layoutX="640.0" layoutY="560.0" onAction="#backButtonOA" text="Back" />

    </children>

</AnchorPane>
