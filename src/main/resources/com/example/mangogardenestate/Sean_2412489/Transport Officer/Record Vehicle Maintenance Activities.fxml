<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Sean_2412489.TransportOfficer.RecordVehicleMaintenanceActivitiesViewController">

    <children>

        <!-- Title -->
        <Label layoutX="190.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Transport Officer - Vehicle Maintenance" />

        <!-- Vehicle Selection -->
        <Label layoutX="50.0" layoutY="74.0" text="Select Vehicle:" />
        <ComboBox fx:id="vehicleComboBox" layoutX="245.0" layoutY="70.0" prefWidth="250.0" promptText="Select Vehicle" />

        <!-- Maintenance Type -->
        <Label layoutX="50.0" layoutY="114.0" text="Maintenance Type:" />
        <ComboBox fx:id="typeComboBox" layoutX="245.0" layoutY="110.0" prefWidth="250.0" promptText="Select Service Type" />

        <!-- Maintenance Date -->
        <Label layoutX="50.0" layoutY="154.0" text="Service Date:" />
        <DatePicker fx:id="serviceDatePicker" layoutX="245.0" layoutY="150.0" prefWidth="250.0" />

        <!-- Service Cost -->
        <Label layoutX="50.0" layoutY="194.0" text="Service Cost ($):" />
        <TextField fx:id="costField" layoutX="245.0" layoutY="190.0" prefWidth="250.0" promptText="Enter Service Cost" />

        <!-- Service Provider / Garage -->
        <Label layoutX="50.0" layoutY="234.0" text="Service Provider:" />
        <TextField fx:id="providerField" layoutX="245.0" layoutY="230.0" prefWidth="250.0" promptText="Enter Service Center Name" />

        <!-- Maintenance Details -->
        <Label layoutX="50.0" layoutY="280.0" text="Service Details:" />
        <TextArea fx:id="detailsArea" layoutX="245.0" layoutY="275.0" prefHeight="120.0" prefWidth="320.0" promptText="Enter detailed service description (optional)" />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="420.0" mnemonicParsing="false" onAction="#saveMaintenanceButtonOA" text="Save Maintenance Record" />
        <Button layoutX="410.0" layoutY="420.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear Form" />

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="475.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>