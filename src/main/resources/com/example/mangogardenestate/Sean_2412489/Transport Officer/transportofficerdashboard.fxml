<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Sean_2412489.TransportOfficer.TransportOfficerDashboardController">

    <!-- Top Bar -->
    <top>
        <AnchorPane prefHeight="60.0" prefWidth="1000.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="20.0" layoutY="16.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Mango Garden Estate - Transport Officer Dashboard" />
                <Button layoutX="890.0" layoutY="16.0" mnemonicParsing="false" onAction="#logoutButtonOA" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Logout" />
            </children>
        </AnchorPane>
    </top>

    <!-- Left Navigation Menu -->
    <left>
        <AnchorPane prefHeight="640.0" prefWidth="220.0" style="-fx-background-color: #34495e;" BorderPane.alignment="CENTER">
            <children>
                <Button layoutX="10.0" layoutY="30.0" prefWidth="200.0" onAction="#openAssignVehiclesOA" style="-fx-background-color: #2980b9; -fx-text-fill: white;" text="Assign Vehicles" />
                <Button layoutX="10.0" layoutY="75.0" prefWidth="200.0" onAction="#openGenerateReportsOA" style="-fx-background-color: #2980b9; -fx-text-fill: white;" text="Generate Reports" />
                <Button layoutX="10.0" layoutY="120.0" prefWidth="200.0" onAction="#openManageDriverAssignmentsOA" style="-fx-background-color: #2980b9; -fx-text-fill: white;" text="Driver Assignments" />
                <Button layoutX="10.0" layoutY="165.0" prefWidth="200.0" onAction="#openManageDispatchOperationsOA" style="-fx-background-color: #2980b9; -fx-text-fill: white;" text="Warehouse Dispatch" />
                <Button layoutX="10.0" layoutY="210.0" prefWidth="200.0" onAction="#openMonitorFuelConsumptionOA" style="-fx-background-color: #2980b9; -fx-text-fill: white;" text="Monitor Fuel Records" />
                <Button layoutX="10.0" layoutY="255.0" prefWidth="200.0" onAction="#openRecordVehicleMaintenanceOA" style="-fx-background-color: #2980b9; -fx-text-fill: white;" text="Vehicle Maintenance" />
                <Button layoutX="10.0" layoutY="300.0" prefWidth="200.0" onAction="#openScheduleDeliveriesOA" style="-fx-background-color: #2980b9; -fx-text-fill: white;" text="Schedule Deliveries" />
                <Button layoutX="10.0" layoutY="345.0" prefWidth="200.0" onAction="#openTrackDeliveryStatusOA" style="-fx-background-color: #2980b9; -fx-text-fill: white;" text="Track Delivery Status" />
            </children>
        </AnchorPane>
    </left>

    <!-- Main Dynamic Content Area -->
    <center>
        <AnchorPane fx:id="mainContentPane" prefHeight="640.0" prefWidth="780.0" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="200.0" layoutY="280.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="Welcome to Transport Officer Dashboard" />
            </children>
        </AnchorPane>
    </center>

</BorderPane>