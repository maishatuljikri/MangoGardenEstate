<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Sean_2412489.TransportOfficer.TrackDeliveryStatusViewController">

    <children>

        <!-- Title -->
        <Label layoutX="200.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Transport Officer - Track Delivery Status" />

        <!-- Delivery ID Search -->
        <Label layoutX="50.0" layoutY="74.0" text="Delivery ID / Order ID:" />
        <TextField fx:id="deliveryIdField" layoutX="200.0" layoutY="70.0" prefWidth="180.0" promptText="Enter ID" />

        <!-- Search Button -->
        <Button layoutX="400.0" layoutY="70.0" mnemonicParsing="false" onAction="#searchDeliveryButtonOA" text="Search" />

        <!-- Delivery Status Table -->
        <TableView fx:id="deliveryTable" layoutX="50.0" layoutY="120.0" prefHeight="340.0" prefWidth="680.0">
            <columns>
                <TableColumn fx:id="deliveryIdColumn" prefWidth="100.0" text="Delivery ID" />
                <TableColumn fx:id="orderIdColumn" prefWidth="100.0" text="Order ID" />
                <TableColumn fx:id="vehicleColumn" prefWidth="120.0" text="Assigned Vehicle" />
                <TableColumn fx:id="destinationColumn" prefWidth="180.0" text="Destination" />
                <TableColumn fx:id="statusColumn" prefWidth="178.0" text="Current Status" />
            </columns>
        </TableView>

        <!-- Update Status Section -->
        <Label layoutX="50.0" layoutY="484.0" text="Update Status:" />
        <ComboBox fx:id="statusComboBox" layoutX="160.0" layoutY="480.0" prefWidth="200.0" promptText="Select New Status" />

        <Button layoutX="380.0" layoutY="480.0" mnemonicParsing="false" onAction="#updateStatusButtonOA" text="Update Delivery Status" />
        <Button layoutX="560.0" layoutY="480.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear" />

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="50.0" layoutY="540.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>