<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Sean_2412489.TransportOfficer.ScheduleMangoDeliveriesViewController">

    <children>

        <!-- Title -->
        <Label layoutX="210.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Transport Officer - Schedule Delivery" />

        <!-- Delivery Order ID -->
        <Label layoutX="50.0" layoutY="74.0" text="Order ID:" />
        <TextField fx:id="orderIdField" layoutX="245.0" layoutY="70.0" prefWidth="250.0" promptText="Enter Order ID" />

        <!-- Customer Name -->
        <Label layoutX="50.0" layoutY="114.0" text="Customer Name:" />
        <TextField fx:id="customerNameField" layoutX="245.0" layoutY="110.0" prefWidth="250.0" promptText="Enter Customer Name" />

        <!-- Destination Address -->
        <Label layoutX="50.0" layoutY="154.0" text="Destination Address:" />
        <TextField fx:id="destinationField" layoutX="245.0" layoutY="150.0" prefWidth="250.0" promptText="Enter Destination Address" />

        <!-- Delivery Date -->
        <Label layoutX="50.0" layoutY="194.0" text="Scheduled Delivery Date:" />
        <DatePicker fx:id="deliveryDatePicker" layoutX="245.0" layoutY="190.0" prefWidth="250.0" />

        <!-- Delivery Time Slot -->
        <Label layoutX="50.0" layoutY="234.0" text="Preferred Time Slot:" />
        <ComboBox fx:id="timeSlotComboBox" layoutX="245.0" layoutY="230.0" prefWidth="250.0" promptText="Select Time Slot" />

        <!-- Special Handling / Instructions -->
        <Label layoutX="50.0" layoutY="280.0" text="Delivery Instructions:" />
        <TextArea fx:id="instructionsArea" layoutX="245.0" layoutY="275.0" prefHeight="120.0" prefWidth="320.0" promptText="Enter special delivery instructions (optional)" />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="420.0" mnemonicParsing="false" onAction="#saveScheduleButtonOA" text="Schedule Delivery" />
        <Button layoutX="380.0" layoutY="420.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear Form" />

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="475.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>