<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Sean_2412489.Accountant.TrackCustomerPaymentRecordsViewController">

    <children>

        <!-- Title -->
        <Label layoutX="190.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Accountant - Track Customer Payments" />

        <!-- Filters -->
        <Label layoutX="50.0" layoutY="74.0" text="Customer Name / ID:" />
        <TextField fx:id="customerSearchField" layoutX="190.0" layoutY="70.0" prefWidth="180.0" promptText="Enter Name or ID" />

        <Label layoutX="390.0" layoutY="74.0" text="Filter Status:" />
        <ComboBox fx:id="statusFilterComboBox" layoutX="470.0" layoutY="70.0" prefWidth="150.0" promptText="Select Status" />

        <Button layoutX="640.0" layoutY="70.0" mnemonicParsing="false" onAction="#searchPaymentsButtonOA" text="Search" />

        <!-- Table -->
        <TableView fx:id="paymentRecordsTable" layoutX="50.0" layoutY="120.0" prefHeight="380.0" prefWidth="680.0">
            <columns>
                <TableColumn fx:id="paymentIdColumn" prefWidth="100.0" text="Payment ID" />
                <TableColumn fx:id="orderIdColumn" prefWidth="100.0" text="Order ID" />
                <TableColumn fx:id="customerNameColumn" prefWidth="180.0" text="Customer Name" />
                <TableColumn fx:id="amountColumn" prefWidth="110.0" text="Amount ($)" />
                <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date" />
                <TableColumn fx:id="statusColumn" prefWidth="88.0" text="Status" />
            </columns>
        </TableView>

        <!-- Action Buttons -->
        <Button layoutX="200.0" layoutY="520.0" mnemonicParsing="false" onAction="#updateStatusButtonOA" text="Update Selected Payment Status" />
        <Button layoutX="450.0" layoutY="520.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear Form" />

        <!-- Status Message -->
        <Label fx:id="messageLabel" layoutX="50.0" layoutY="565.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>