<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Sean_2412489.Accountant.MonitorProfitAndLossSummariesViewController">

    <children>

        <!-- Title -->
        <Label layoutX="180.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Accountant - Profit &amp; Loss Summaries" />

        <!-- Filter Controls -->
        <Label layoutX="50.0" layoutY="74.0" text="Fiscal Year:" />
        <ComboBox fx:id="fiscalYearComboBox" layoutX="130.0" layoutY="70.0" prefWidth="120.0" promptText="Year" />

        <Label layoutX="280.0" layoutY="74.0" text="Quarter:" />
        <ComboBox fx:id="quarterComboBox" layoutX="340.0" layoutY="70.0" prefWidth="120.0" promptText="Quarter" />

        <Label layoutX="480.0" layoutY="74.0" text="Year:" />
        <TextField fx:id="yearField" layoutX="520.0" layoutY="70.0" prefWidth="120.0" promptText="e.g. 2026" />

        <!-- Buttons -->
        <Button layoutX="260.0" layoutY="120.0" mnemonicParsing="false" onAction="#viewSummaryButtonOA" text="View Summary" />
        <Button layoutX="380.0" layoutY="120.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear" />

        <!-- Profit & Loss Summary Table -->
        <TableView fx:id="summaryTable" layoutX="50.0" layoutY="170.0" prefHeight="330.0" prefWidth="680.0">
            <columns>
                <TableColumn fx:id="itemColumn" prefWidth="240.0" text="Financial Item" />
                <TableColumn fx:id="revenueColumn" prefWidth="220.0" text="Total Revenue ($)" />
                <TableColumn fx:id="expenseColumn" prefWidth="218.0" text="Total Expense ($)" />
            </columns>
        </TableView>

        <!-- Summary Totals -->
        <Label layoutX="50.0" layoutY="520.0" style="-fx-font-weight:bold; -fx-font-size:16px;" text="Net Profit/Loss:" />
        <Label fx:id="netProfitLossLabel" layoutX="180.0" layoutY="520.0" style="-fx-font-weight:bold; -fx-font-size:16px; -fx-text-fill:blue;" text="0.00 USD" />

        <!-- Status Message -->
        <Label fx:id="messageLabel" layoutX="50.0" layoutY="560.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>