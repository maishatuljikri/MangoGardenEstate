<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Sean_2412489.Accountant.GenerateMonthlyFinancialReportsViewController">

    <children>

        <!-- Title -->
        <Label layoutX="210.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Accountant - Monthly Financial Report" />

        <!-- Select Month -->
        <Label layoutX="50.0" layoutY="74.0" text="Select Month:" />
        <ComboBox fx:id="monthComboBox" layoutX="160.0" layoutY="70.0" prefWidth="180.0" promptText="Select Month" />

        <!-- Select Year -->
        <Label layoutX="380.0" layoutY="74.0" text="Select Year:" />
        <TextField fx:id="yearField" layoutX="470.0" layoutY="70.0" prefWidth="150.0" promptText="e.g. 2026" />

        <!-- Action Buttons -->
        <Button layoutX="200.0" layoutY="120.0" mnemonicParsing="false" onAction="#generateReportButtonOA" text="Generate Report" />
        <Button layoutX="350.0" layoutY="120.0" mnemonicParsing="false" onAction="#downloadReportButtonOA" text="Download Report" />
        <Button layoutX="500.0" layoutY="120.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear" />

        <!-- Report Summary Table -->
        <TableView fx:id="financialReportTable" layoutX="50.0" layoutY="170.0" prefHeight="360.0" prefWidth="680.0">
            <columns>
                <TableColumn fx:id="categoryColumn" prefWidth="200.0" text="Category" />
                <TableColumn fx:id="incomeColumn" prefWidth="160.0" text="Income ($)" />
                <TableColumn fx:id="expenseColumn" prefWidth="160.0" text="Expense ($)" />
                <TableColumn fx:id="netColumn" prefWidth="158.0" text="Net ($)" />
            </columns>
        </TableView>

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="50.0" layoutY="550.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>