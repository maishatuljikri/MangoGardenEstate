<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Sean_2412489.Accountant.ManageOperationalExpensesViewController">

    <children>

        <!-- Title -->
        <Label layoutX="220.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Accountant - Operational Expenses" />

        <!-- Expense Category -->
        <Label layoutX="50.0" layoutY="74.0" text="Expense Category:" />
        <ComboBox fx:id="categoryComboBox" layoutX="245.0" layoutY="70.0" prefWidth="250.0" promptText="Select Category" />

        <!-- Expense Title/Name -->
        <Label layoutX="50.0" layoutY="114.0" text="Expense Title:" />
        <TextField fx:id="expenseTitleField" layoutX="245.0" layoutY="110.0" prefWidth="250.0" promptText="Enter Title/Description" />

        <!-- Expense Amount -->
        <Label layoutX="50.0" layoutY="154.0" text="Amount ($):" />
        <TextField fx:id="amountField" layoutX="245.0" layoutY="150.0" prefWidth="250.0" promptText="Enter Amount" />

        <!-- Expense Date -->
        <Label layoutX="50.0" layoutY="194.0" text="Expense Date:" />
        <DatePicker fx:id="expenseDatePicker" layoutX="245.0" layoutY="190.0" prefWidth="250.0" />

        <!-- Additional Notes -->
        <Label layoutX="50.0" layoutY="240.0" text="Expense Details:" />
        <TextArea fx:id="detailsArea" layoutX="245.0" layoutY="235.0" prefHeight="120.0" prefWidth="320.0" promptText="Enter additional expense details (optional)" />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="380.0" mnemonicParsing="false" onAction="#saveExpenseButtonOA" text="Save Expense" />
        <Button layoutX="360.0" layoutY="380.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear Form" />

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="435.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>