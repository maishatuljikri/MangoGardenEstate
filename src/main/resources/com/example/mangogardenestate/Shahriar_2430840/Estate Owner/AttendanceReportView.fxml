<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="560.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Shahriar_2430840.EstateOwner.WorkerAttendanceController">

    <children>

        <!-- Title -->
        <Label layoutX="180.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Worker Attendance Report" />

        <!-- Worker ID -->
        <Label layoutX="50.0" layoutY="80.0" text="Worker ID :" />

        <TextField fx:id="txtWorkerId" layoutX="180.0" layoutY="75.0" prefWidth="220.0" />

        <!-- Worker Name -->
        <Label layoutX="50.0" layoutY="125.0" text="Worker Name :" />

        <TextField fx:id="txtWorkerName" layoutX="180.0" layoutY="120.0" prefWidth="220.0" />

        <!-- Attendance Date -->
        <Label layoutX="50.0" layoutY="170.0" text="Attendance Date :" />

        <TextField fx:id="txtAttendanceDate" layoutX="180.0" layoutY="165.0" prefWidth="220.0" />

        <!-- Attendance Status -->
        <Label layoutX="50.0" layoutY="215.0" text="Attendance Status :" />

        <TextField fx:id="txtStatus" layoutX="180.0" layoutY="210.0" prefWidth="220.0" />

        <!-- Total Present -->
        <Label layoutX="50.0" layoutY="260.0" text="Total Present :" />

        <TextField fx:id="txtPresent" layoutX="180.0" layoutY="255.0" prefWidth="220.0" />

        <!-- Attendance Summary -->
        <Label layoutX="50.0" layoutY="305.0" text="Attendance Report :" />

        <TextArea fx:id="txtReport" layoutX="180.0" layoutY="300.0" prefHeight="120.0" prefWidth="360.0" />

        <!-- Buttons -->
        <Button layoutX="430.0" layoutY="75.0" onAction="#searchAttendanceOA" prefWidth="120.0" text="Search" />

        <Button layoutX="80.0" layoutY="455.0" onAction="#calculateAttendanceOA" prefWidth="130.0" text="Calculate" />

        <Button layoutX="240.0" layoutY="455.0" onAction="#viewReportOA" prefWidth="130.0" text="View" />

        <Button layoutX="400.0" layoutY="455.0" onAction="#clearFormOA" prefWidth="130.0" text="Clear" />

        <Button layoutX="560.0" layoutY="455.0" onAction="#goBackOA" prefWidth="100.0" text="Back" />

    </children>

</AnchorPane>
