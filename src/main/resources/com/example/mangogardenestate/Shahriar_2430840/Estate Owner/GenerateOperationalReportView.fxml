<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="560.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Shahriar_2430840.EstateOwner.OperationalReportController">

    <children>

        <!-- Title -->
        <Label layoutX="150.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Generate Operational Report" />

        <!-- Report ID -->
        <Label layoutX="50.0" layoutY="80.0" text="Report ID :" />

        <TextField fx:id="txtReportId" layoutX="190.0" layoutY="75.0" prefWidth="220.0" />

        <!-- Report Category -->
        <Label layoutX="50.0" layoutY="125.0" text="Report Category :" />

        <TextField fx:id="txtCategory" layoutX="190.0" layoutY="120.0" prefWidth="220.0" />

        <!-- Production Record -->
        <Label layoutX="50.0" layoutY="170.0" text="Production Record :" />

        <TextField fx:id="txtProduction" layoutX="190.0" layoutY="165.0" prefWidth="220.0" />

        <!-- Sales Record -->
        <Label layoutX="50.0" layoutY="215.0" text="Sales Record :" />

        <TextField fx:id="txtSales" layoutX="190.0" layoutY="210.0" prefWidth="220.0" />

        <!-- Report Status -->
        <Label layoutX="50.0" layoutY="260.0" text="Report Status :" />

        <TextField fx:id="txtStatus" layoutX="190.0" layoutY="255.0" prefWidth="220.0" />

        <!-- Operational Report -->
        <Label layoutX="50.0" layoutY="305.0" text="Operational Report :" />

        <TextArea fx:id="txtReport" layoutX="190.0" layoutY="300.0" prefHeight="120.0" prefWidth="360.0" />

        <!-- Buttons -->
        <Button layoutX="440.0" layoutY="75.0" onAction="#searchReportOA" prefWidth="120.0" text="Search" />

        <Button layoutX="70.0" layoutY="455.0" onAction="#generateReportOA" prefWidth="140.0" text="Generate" />

        <Button layoutX="230.0" layoutY="455.0" onAction="#viewReportOA" prefWidth="120.0" text="View" />

        <Button layoutX="370.0" layoutY="455.0" onAction="#downloadReportOA" prefWidth="120.0" text="Download" />

        <Button layoutX="510.0" layoutY="455.0" onAction="#clearFormOA" prefWidth="120.0" text="Back" />

    </children>

</AnchorPane>
