<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Accountant.RecordSalesViewController">

    <children>

        <!-- Title -->
        <Label layoutX="240.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Accountant - Record Daily Sales" />

        <!-- Order ID -->
        <Label layoutX="50.0" layoutY="74.0" text="Customer Order ID:" />
        <TextField fx:id="orderIdField" layoutX="245.0" layoutY="70.0" promptText="Enter Order ID" />

        <!-- Customer Name -->
        <Label layoutX="50.0" layoutY="114.0" text="Customer Name:" />
        <TextField fx:id="customerNameField" layoutX="245.0" layoutY="110.0" promptText="Enter Customer Name" />

        <!-- Transaction Date -->
        <Label layoutX="50.0" layoutY="154.0" text="Transaction Date:" />
        <DatePicker fx:id="transactionDatePicker" layoutX="245.0" layoutY="150.0" />

        <!-- Total Sales Amount -->
        <Label layoutX="50.0" layoutY="194.0" text="Sales Amount ($):" />
        <TextField fx:id="amountField" layoutX="245.0" layoutY="190.0" promptText="Enter Amount" />

        <!-- Payment Method -->
        <Label layoutX="50.0" layoutY="234.0" text="Payment Method:" />
        <ComboBox fx:id="paymentMethodComboBox" layoutX="245.0" layoutY="230.0" prefWidth="250" promptText="Select Payment Method" />

        <!-- Remarks / Notes -->
        <Label layoutX="50.0" layoutY="289.0" text="Transaction Notes:" />
        <TextArea fx:id="notesArea" layoutX="245.0" layoutY="280.0" prefHeight="120" prefWidth="320" promptText="Enter sales remarks (optional)" />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="440.0" mnemonicParsing="false" onAction="#saveSalesButtonOA" text="Save Sales Record" />
        <Button layoutX="400.0" layoutY="440.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear Form" />

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="495.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>