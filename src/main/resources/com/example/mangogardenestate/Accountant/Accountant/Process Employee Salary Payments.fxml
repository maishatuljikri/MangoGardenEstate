<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Accountant.ProcessSalaryViewController">

    <children>

        <!-- Title -->
        <Label layoutX="210.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Accountant - Process Salary Payments" />

        <!-- Employee ID -->
        <Label layoutX="50.0" layoutY="74.0" text="Employee ID:" />
        <TextField fx:id="employeeIdField" layoutX="245.0" layoutY="70.0" prefWidth="250.0" promptText="Enter Employee ID" />

        <!-- Employee Name -->
        <Label layoutX="50.0" layoutY="114.0" text="Employee Name:" />
        <TextField fx:id="employeeNameField" layoutX="245.0" layoutY="110.0" prefWidth="250.0" promptText="Enter Employee Name" />

        <!-- Role / Department -->
        <Label layoutX="50.0" layoutY="154.0" text="Role / Department:" />
        <ComboBox fx:id="roleComboBox" layoutX="245.0" layoutY="150.0" prefWidth="250.0" promptText="Select Role" />

        <!-- Base Salary -->
        <Label layoutX="50.0" layoutY="194.0" text="Base Salary ($):" />
        <TextField fx:id="baseSalaryField" layoutX="245.0" layoutY="190.0" prefWidth="250.0" promptText="Enter Base Salary" />

        <!-- Allowances / Bonus -->
        <Label layoutX="50.0" layoutY="234.0" text="Allowances / Bonus ($):" />
        <TextField fx:id="bonusField" layoutX="245.0" layoutY="230.0" prefWidth="250.0" promptText="Enter Bonus (optional)" />

        <!-- Deductions -->
        <Label layoutX="50.0" layoutY="274.0" text="Deductions ($):" />
        <TextField fx:id="deductionsField" layoutX="245.0" layoutY="270.0" prefWidth="250.0" promptText="Enter Deductions (optional)" />

        <!-- Payment Date -->
        <Label layoutX="50.0" layoutY="314.0" text="Payment Date:" />
        <DatePicker fx:id="paymentDatePicker" layoutX="245.0" layoutY="310.0" prefWidth="250.0" />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="380.0" mnemonicParsing="false" onAction="#calculateSalaryButtonOA" text="Calculate Salary" />
        <Button layoutX="360.0" layoutY="380.0" mnemonicParsing="false" onAction="#processPaymentButtonOA" text="Process Payment" />
        <Button layoutX="500.0" layoutY="380.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear Form" />

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="435.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>