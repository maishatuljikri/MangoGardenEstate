<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.Accountant.ManageSupplierInvoicesViewController">

    <children>

        <!-- Title -->
        <Label layoutX="220.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Accountant - Supplier Invoices" />

        <!-- Invoice Number -->
        <Label layoutX="50.0" layoutY="74.0" text="Invoice Number:" />
        <TextField fx:id="invoiceNumberField" layoutX="245.0" layoutY="70.0" prefWidth="250.0" promptText="Enter Invoice Number" />

        <!-- Supplier Name -->
        <Label layoutX="50.0" layoutY="114.0" text="Supplier Name:" />
        <TextField fx:id="supplierNameField" layoutX="245.0" layoutY="110.0" prefWidth="250.0" promptText="Enter Supplier Name" />

        <!-- Total Invoice Amount -->
        <Label layoutX="50.0" layoutY="154.0" text="Invoice Amount ($):" />
        <TextField fx:id="amountField" layoutX="245.0" layoutY="150.0" prefWidth="250.0" promptText="Enter Amount" />

        <!-- Invoice Date -->
        <Label layoutX="50.0" layoutY="194.0" text="Invoice Date:" />
        <DatePicker fx:id="invoiceDatePicker" layoutX="245.0" layoutY="190.0" prefWidth="250.0" />

        <!-- Payment Status -->
        <Label layoutX="50.0" layoutY="234.0" text="Payment Status:" />
        <ComboBox fx:id="statusComboBox" layoutX="245.0" layoutY="230.0" prefWidth="250.0" promptText="Select Status" />

        <!-- Invoice Details / Items -->
        <Label layoutX="50.0" layoutY="280.0" text="Invoice Details:" />
        <TextArea fx:id="detailsArea" layoutX="245.0" layoutY="275.0" prefHeight="120.0" prefWidth="320.0" promptText="Enter supply items and details (optional)" />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="420.0" mnemonicParsing="false" onAction="#saveInvoiceButtonOA" text="Save Invoice" />
        <Button layoutX="350.0" layoutY="420.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear Form" />

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="475.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>
