<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="560.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.gardenManager.PestControlActivityController">

    <children>

        <!-- Title -->
        <Label layoutX="170.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Pest Control Activities" />

        <!-- Record ID -->
        <Label layoutX="50.0" layoutY="80.0" text="Record ID :" />

        <TextField fx:id="txtRecordId" layoutX="200.0" layoutY="75.0" prefWidth="220.0" />

        <!-- Garden Area -->
        <Label layoutX="50.0" layoutY="125.0" text="Garden Area :" />

        <TextField fx:id="txtGardenArea" layoutX="200.0" layoutY="120.0" prefWidth="220.0" />

        <!-- Pesticide Name -->
        <Label layoutX="50.0" layoutY="170.0" text="Pesticide Name :" />

        <TextField fx:id="txtPesticide" layoutX="200.0" layoutY="165.0" prefWidth="220.0" />

        <!-- Quantity Used -->
        <Label layoutX="50.0" layoutY="215.0" text="Quantity Used :" />

        <TextField fx:id="txtQuantity" layoutX="200.0" layoutY="210.0" prefWidth="220.0" />

        <!-- Application Date -->
        <Label layoutX="50.0" layoutY="260.0" text="Application Date :" />

        <TextField fx:id="txtApplicationDate" layoutX="200.0" layoutY="255.0" prefWidth="220.0" />

        <!-- Pest Control Details -->
        <Label layoutX="50.0" layoutY="305.0" text="Pest Control Details :" />

        <TextArea fx:id="txtDetails" layoutX="200.0" layoutY="300.0" prefHeight="120.0" prefWidth="360.0" />

        <!-- Buttons -->
        <Button layoutX="450.0" layoutY="75.0" onAction="#verifyRecordOA" prefWidth="120.0" text="Verify" />

        <Button layoutX="70.0" layoutY="455.0" onAction="#saveRecordOA" prefWidth="130.0" text="Save" />

        <Button layoutX="220.0" layoutY="455.0" onAction="#viewSummaryOA" prefWidth="130.0" text="View" />

        <Button layoutX="370.0" layoutY="455.0" onAction="#clearFormOA" prefWidth="130.0" text="Clear" />

        <Button layoutX="520.0" layoutY="455.0" onAction="#goBackOA" prefWidth="120.0" text="Back" />

    </children>

</AnchorPane>
