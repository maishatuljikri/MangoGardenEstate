<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="560.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.gardenManager.RecordTreeConditionController">

    <children>

        <!-- Title -->
        <Label layoutX="160.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Record Mango Tree Conditions" />

        <!-- Tree ID -->
        <Label layoutX="50.0" layoutY="80.0" text="Tree ID :" />

        <TextField fx:id="txtTreeId" layoutX="190.0" layoutY="75.0" prefWidth="220.0" />

        <!-- Garden Section -->
        <Label layoutX="50.0" layoutY="125.0" text="Garden Section :" />

        <TextField fx:id="txtSection" layoutX="190.0" layoutY="120.0" prefWidth="220.0" />

        <!-- Tree Condition -->
        <Label layoutX="50.0" layoutY="170.0" text="Tree Condition :" />

        <TextField fx:id="txtCondition" layoutX="190.0" layoutY="165.0" prefWidth="220.0" />

        <!-- Inspection Date -->
        <Label layoutX="50.0" layoutY="215.0" text="Inspection Date :" />

        <TextField fx:id="txtInspectionDate" layoutX="190.0" layoutY="210.0" prefWidth="220.0" />

        <!-- Inspector -->
        <Label layoutX="50.0" layoutY="260.0" text="Inspector Name :" />

        <TextField fx:id="txtInspector" layoutX="190.0" layoutY="255.0" prefWidth="220.0" />

        <!-- Condition Details -->
        <Label layoutX="50.0" layoutY="305.0" text="Condition Details :" />

        <TextArea fx:id="txtDetails" layoutX="190.0" layoutY="300.0" prefHeight="120.0" prefWidth="360.0" />

        <!-- Buttons -->
        <Button layoutX="430.0" layoutY="75.0" onAction="#verifySectionOA" prefWidth="120.0" text="Verify" />

        <Button layoutX="70.0" layoutY="455.0" onAction="#saveConditionOA" prefWidth="130.0" text="Save" />

        <Button layoutX="220.0" layoutY="455.0" onAction="#viewConfirmationOA" prefWidth="130.0" text="View" />

        <Button layoutX="370.0" layoutY="455.0" onAction="#clearFormOA" prefWidth="130.0" text="Clear" />

        <Button layoutX="520.0" layoutY="455.0" onAction="#goBackOA" prefWidth="120.0" text="Back" />

    </children>

</AnchorPane>
