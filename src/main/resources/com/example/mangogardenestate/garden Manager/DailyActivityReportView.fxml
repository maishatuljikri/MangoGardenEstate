<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="560.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DailyActivityReportController">

    <children>

        <!-- Title -->
        <Label layoutX="150.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Generate Daily Activity Report" />

        <!-- Report ID -->
        <Label layoutX="50.0" layoutY="80.0" text="Report ID :" />

        <TextField fx:id="txtReportId" layoutX="200.0" layoutY="75.0" prefWidth="220.0" />

        <!-- Report Date -->
        <Label layoutX="50.0" layoutY="125.0" text="Report Date :" />

        <TextField fx:id="txtReportDate" layoutX="200.0" layoutY="120.0" prefWidth="220.0" />

        <!-- Irrigation Record -->
        <Label layoutX="50.0" layoutY="170.0" text="Irrigation Record :" />

        <TextField fx:id="txtIrrigation" layoutX="200.0" layoutY="165.0" prefWidth="220.0" />

        <!-- Fertilizer Record -->
        <Label layoutX="50.0" layoutY="215.0" text="Fertilizer Record :" />

        <TextField fx:id="txtFertilizer" layoutX="200.0" layoutY="210.0" prefWidth="220.0" />

        <!-- Labor Record -->
        <Label layoutX="50.0" layoutY="260.0" text="Labor Record :" />

        <TextField fx:id="txtLabor" layoutX="200.0" layoutY="255.0" prefWidth="220.0" />

        <!-- Daily Activity Report -->
        <Label layoutX="50.0" layoutY="305.0" text="Activity Report :" />

        <TextArea fx:id="txtReport" layoutX="200.0" layoutY="300.0" prefHeight="120.0" prefWidth="360.0" />

        <!-- Buttons -->
        <Button layoutX="450.0" layoutY="75.0" onAction="#verifyDataOA" prefWidth="120.0" text="Verify" />

        <Button layoutX="50.0" layoutY="455.0" onAction="#generateReportOA" prefWidth="130.0" text="Generate" />

        <Button layoutX="200.0" layoutY="455.0" onAction="#viewReportOA" prefWidth="120.0" text="View" />

        <Button layoutX="340.0" layoutY="455.0" onAction="#downloadReportOA" prefWidth="120.0" text="Download" />

        <Button layoutX="480.0" layoutY="455.0" onAction="#clearFormOA" prefWidth="120.0" text="Clear" />

        <Button layoutX="610.0" layoutY="455.0" onAction="#goBackOA" prefWidth="90.0" text="Back" />

    </children>

</AnchorPane>
