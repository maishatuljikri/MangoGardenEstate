<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.TransportOfficer.GenerateTransportReportViewController">

    <children>

        <!-- Title -->
        <Label layoutX="190.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Transport Officer - Transportation Report" />

        <!-- Report Category -->
        <Label layoutX="50.0" layoutY="74.0" text="Report Category:" />
        <ComboBox fx:id="categoryComboBox" layoutX="165.0" layoutY="70.0" prefWidth="180.0" promptText="Select Category" />

        <!-- Date Range Selection -->
        <Label layoutX="365.0" layoutY="74.0" text="From:" />
        <DatePicker fx:id="fromDatePicker" layoutX="405.0" layoutY="70.0" prefWidth="130.0" />

        <Label layoutX="550.0" layoutY="74.0" text="To:" />
        <DatePicker fx:id="toDatePicker" layoutX="575.0" layoutY="70.0" prefWidth="130.0" />

        <!-- Action Buttons -->
        <Button layoutX="200.0" layoutY="120.0" mnemonicParsing="false" onAction="#generateReportButtonOA" text="Generate Report" />
        <Button layoutX="350.0" layoutY="120.0" mnemonicParsing="false" onAction="#downloadReportButtonOA" text="Download Report" />
        <Button layoutX="500.0" layoutY="120.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear" />

        <!-- Report Data Table -->
        <TableView fx:id="transportReportTable" layoutX="50.0" layoutY="170.0" prefHeight="360.0" prefWidth="680.0">
            <columns>
                <TableColumn fx:id="reportIdColumn" prefWidth="90.0" text="Report ID" />
                <TableColumn fx:id="vehicleIdColumn" prefWidth="110.0" text="Vehicle ID" />
                <TableColumn fx:id="driverNameColumn" prefWidth="150.0" text="Driver Name" />
                <TableColumn fx:id="deliveriesCountColumn" prefWidth="130.0" text="Total Deliveries" />
                <TableColumn fx:id="statusColumn" prefWidth="198.0" text="Overall Status" />
            </columns>
        </TableView>

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="50.0" layoutY="550.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>