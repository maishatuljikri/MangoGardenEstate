<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.TransportOfficer.AssignVehicleViewController">

    <children>

        <!-- Title -->
        <Label layoutX="200.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Transport Officer - Assign Vehicle" />

        <!-- Delivery Order ID -->
        <Label layoutX="50.0" layoutY="74.0" text="Delivery Order ID:" />
        <TextField fx:id="orderIdField" layoutX="245.0" layoutY="70.0" prefWidth="250.0" promptText="Enter Order ID" />

        <!-- Select Vehicle -->
        <Label layoutX="50.0" layoutY="124.0" text="Select Vehicle:" />
        <ComboBox fx:id="vehicleComboBox" layoutX="245.0" layoutY="120.0" prefWidth="250.0" promptText="Select Available Vehicle" />

        <!-- Vehicle Type -->
        <Label layoutX="50.0" layoutY="174.0" text="Vehicle Type:" />
        <Label fx:id="vehicleTypeLabel" layoutX="245.0" layoutY="174.0" style="-fx-font-weight:bold;" text="—" />

        <!-- Cargo Capacity -->
        <Label layoutX="50.0" layoutY="214.0" text="Cargo Capacity (kg):" />
        <Label fx:id="capacityLabel" layoutX="245.0" layoutY="214.0" style="-fx-font-weight:bold;" text="—" />

        <!-- Destination -->
        <Label layoutX="50.0" layoutY="254.0" text="Destination:" />
        <TextField fx:id="destinationField" layoutX="245.0" layoutY="250.0" prefWidth="250.0" promptText="Enter Destination" />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="320.0" mnemonicParsing="false" onAction="#assignVehicleButtonOA" text="Assign Vehicle" />
        <Button layoutX="360.0" layoutY="320.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear Form" />

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="375.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>
