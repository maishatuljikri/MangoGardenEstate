<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mangogardenestate.TransportOfficer.ManageDispatchViewController">

    <children>

        <!-- Title -->
        <Label layoutX="190.0" layoutY="20.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Transport Officer - Warehouse Dispatch" />

        <!-- Dispatch Order ID -->
        <Label layoutX="50.0" layoutY="74.0" text="Dispatch Order ID:" />
        <TextField fx:id="dispatchOrderIdField" layoutX="245.0" layoutY="70.0" prefWidth="250.0" promptText="Enter Dispatch Order ID" />

        <!-- Mango Type / Batch -->
        <Label layoutX="50.0" layoutY="114.0" text="Mango Variety/Batch:" />
        <ComboBox fx:id="mangoVarietyComboBox" layoutX="245.0" layoutY="110.0" prefWidth="250.0" promptText="Select Variety" />

        <!-- Dispatch Quantity -->
        <Label layoutX="50.0" layoutY="154.0" text="Dispatch Quantity (kg):" />
        <TextField fx:id="quantityField" layoutX="245.0" layoutY="150.0" prefWidth="250.0" promptText="Enter Quantity in KG" />

        <!-- Assigned Vehicle -->
        <Label layoutX="50.0" layoutY="194.0" text="Assigned Vehicle:" />
        <ComboBox fx:id="vehicleComboBox" layoutX="245.0" layoutY="190.0" prefWidth="250.0" promptText="Select Vehicle" />

        <!-- Dispatch Date -->
        <Label layoutX="50.0" layoutY="234.0" text="Dispatch Date:" />
        <DatePicker fx:id="dispatchDatePicker" layoutX="245.0" layoutY="230.0" prefWidth="250.0" />

        <!-- Dispatch Notes / Remarks -->
        <Label layoutX="50.0" layoutY="280.0" text="Dispatch Notes:" />
        <TextArea fx:id="notesArea" layoutX="245.0" layoutY="275.0" prefHeight="120.0" prefWidth="320.0" promptText="Enter dispatch remarks or instructions (optional)" />

        <!-- Buttons -->
        <Button layoutX="220.0" layoutY="420.0" mnemonicParsing="false" onAction="#confirmDispatchButtonOA" text="Confirm Dispatch" />
        <Button layoutX="370.0" layoutY="420.0" mnemonicParsing="false" onAction="#clearButtonOA" text="Clear Form" />

        <!-- Status / Confirmation Message -->
        <Label fx:id="messageLabel" layoutX="220.0" layoutY="475.0" style="-fx-text-fill:green; -fx-font-size:14px;" text="" />

    </children>

</AnchorPane>